    @model MyGestWeb.Models.Cuenta

@{
    ViewData["Title"] = "Aumentar Saldo";
}

<h2>Aumentar Saldo</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <div class="card p-3 mb-3">
            <h5>Información de la Cuenta</h5>
            <p><strong>Nro de Cuenta (ID):</strong> @Model.Id</p>
            <p><strong>Saldo Actual:</strong> $@Model.SaldoDisponible</p>
        </div>

        <form asp-action="AumentarSaldo" method="post">
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="mb-3">
                <label for="monto" class="form-label">Monto a agregar:</label>
                <input type="number" step="0.01" min="0.01" name="monto" id="monto" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-success">Aumentar Saldo</button>
            <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
        </form>
    </div>
</div>

