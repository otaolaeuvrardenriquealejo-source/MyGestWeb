@model MyGestWeb.Models.Cuenta

@{
    ViewData["Title"] = "Editar Cuenta";
}

<h1>Editar Cuenta</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Campo oculto obligatorio para mantener el ID de la cuenta -->
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="ClienteId" class="form-label">Cliente</label>
                <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.ClienteId"></select>
                <span asp-validation-for="ClienteId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SaldoDisponible" class="form-label"></label>
                <input asp-for="SaldoDisponible" class="form-control" />
                <span asp-validation-for="SaldoDisponible" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TratamientoEspecifico" class="form-label"></label>
                <input asp-for="TratamientoEspecifico" class="form-control" />
                <span asp-validation-for="TratamientoEspecifico" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <input type="submit" value="Guardar Cambios" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Volver al listado</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}